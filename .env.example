# Copy to .env and adjust. All values are optional except DOWNLOAD_ROOT.

DOWNLOAD_ROOT=C:\songs
AUDIO_FORMAT=wav

# Path to ffmpeg.exe. Leave blank to use whatever is on your PATH.
FFMPEG_LOCATION=

# Tracks shorter/longer than these (seconds) are rejected as ads/clips/podcasts.
MIN_SECONDS=60
MAX_SECONDS=900

# How many tracks download at the same time.
MAX_CONCURRENT_DOWNLOADS=4

# Optional. Without these, Spotify links are skipped. Create a free app at
# https://developer.spotify.com/dashboard to get them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
